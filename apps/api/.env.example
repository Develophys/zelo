# Loaded via src/shared/config/load-env.ts, in this precedence order (first
# match wins, most specific first): .env.$(NODE_ENV).local, .env.local,
# .env.$(NODE_ENV), .env — same convention as Next.js/CRA. NODE_ENV defaults
# to "development" outside of tests. Put real per-developer values (e.g. a
# local Postgres you don't want to keep switching .env for) in
# .env.development.local — it's gitignored and always wins over .env.
DATABASE_URL="postgresql://zelo:devpassword@localhost:5432/zelo?schema=public"
DIRECT_DATABASE_URL="postgresql://zelo:devpassword@localhost:5432/zelo?schema=public"
PORT=3000
# "groq" (default) uses real Groq API calls and requires GROQ_API_KEY.
# "mock" swaps in canned AI responses for local dev/testing — no API key, no token spend.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
MANAGER_TOKEN_SECRET=change-me-in-production
ADMIN_TOKEN_SECRET=change-me-in-production
PEER_PARTNER_TOKEN_SECRET=change-me-in-production
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
