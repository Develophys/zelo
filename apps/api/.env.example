# Loaded via src/shared/config/load-env.ts, in this precedence order (first
# match wins, most specific first): .env.$(NODE_ENV).local, .env.local,
# .env.$(NODE_ENV), .env — same convention as Next.js/CRA. NODE_ENV defaults
# to "development" outside of tests. Put real per-developer values (e.g. a
# local Postgres you don't want to keep switching .env for) in
# .env.development.local — it's gitignored and always wins over .env.
#
# Every variable below is validated at boot by src/shared/config/env.validation.ts
# unless its section says otherwise.

# ── Runtime ─────────────────────────────────────────────────────────────────

# One of "development" | "test" | "production". Defaults to "development".
# "production" turns on the boot-time guards below (32+ character token
# secrets, EMAIL_PROVIDER=resend, an explicit WEB_APP_BASE_URL). The Docker
# image bakes NODE_ENV=production in; you normally don't set this by hand.
# NODE_ENV=development

# Port the HTTP API listens on. Defaults to 3000.
PORT=3000

# Comma-separated list of frontend origins allowed by CORS. Applies to both the
# HTTP API and the peer-chat websocket gateway. When unset, falls back to
# http://localhost:5173 and http://localhost:8080. Set it to the real frontend
# domain(s) in any deployed environment.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# ── Database ────────────────────────────────────────────────────────────────

# Postgres connection string the running API (PrismaService) connects through.
# Required.
DATABASE_URL="postgresql://zelo:devpassword@localhost:5432/zelo?schema=public"

# Direct (non-pooled) connection string used by the Prisma CLI — migrate,
# generate — via prisma.config.ts, and by the seed / admin:create scripts. Must
# point at the same database as DATABASE_URL: the scripts refuse to run when one
# is local and the other is not. Not validated at boot (only the CLI reads it).
DIRECT_DATABASE_URL="postgresql://zelo:devpassword@localhost:5432/zelo?schema=public"

# ── Session tokens ──────────────────────────────────────────────────────────

# HMAC keys signing the session tokens of each account type: hospital managers,
# platform SuperAdmins, and peer partners. Required, and each one must be an
# independent value. In production they must be at least 32 characters (enforced
# at boot); the placeholder below is fine for `pnpm dev` only. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The Docker Compose stack (docker/) boots with NODE_ENV=production, so
# docker/.env.docker needs real values — see docker/.env.example.
MANAGER_TOKEN_SECRET=change-me-in-production
ADMIN_TOKEN_SECRET=change-me-in-production
PEER_PARTNER_TOKEN_SECRET=change-me-in-production

# ── AI provider (chat companion and manager insights) ───────────────────────

# "groq" (default) uses real Groq API calls and requires GROQ_API_KEY.
# "mock" swaps in canned AI responses for local dev/testing — no API key, no token spend.
AI_PROVIDER=groq

# Groq API key. Required unless AI_PROVIDER=mock.
GROQ_API_KEY=

# Groq model used for chat replies and manager insights. When unset the API
# falls back to openai/gpt-oss-120b; the value below overrides that default.
GROQ_MODEL=llama-3.3-70b-versatile

# ── Email ───────────────────────────────────────────────────────────────────

# "mock" (default) logs the email + set-password link to the console for local dev/testing —
# no API key needed. "resend" sends real emails via Resend and requires RESEND_API_KEY.
# Must be "resend" when NODE_ENV=production.
EMAIL_PROVIDER=mock

# Resend API key. Required unless EMAIL_PROVIDER=mock.
RESEND_API_KEY=

# Sender address on outgoing email. Defaults to onboarding@resend.dev, Resend's
# shared test sender; use an address on a domain verified in Resend for real sends.
EMAIL_FROM=onboarding@resend.dev

# Public base URL of the web app, used to build the set-password / reset links
# inside invite and reset emails. Defaults to http://localhost:5173. Must be set
# explicitly (not left at that default) when NODE_ENV=production.
WEB_APP_BASE_URL=http://localhost:5173

# ── Scripts only (not read by the running API; not validated at boot) ───────

# Create or update a real platform SuperAdmin (idempotent per email):
#   pnpm --filter @zelo/api admin:create
# All three are required for that script. The password must be 10 to 200 characters,
# the same policy as set-password (packages/domain password-policy.ts). The script refuses
# to run if DATABASE_URL and DIRECT_DATABASE_URL point at different databases.
# SUPER_ADMIN_NAME=
# SUPER_ADMIN_EMAIL=
# SUPER_ADMIN_PASSWORD=

# Optional overrides for the demo accounts created by `pnpm --filter @zelo/api seed`
# (see prisma/seed-data.ts and prisma/README.md). When unset, the seed
# uses the committed demo passwords, so set these whenever the seed runs against
# anything but a throwaway local database.
# MANAGER_SEED_PASSWORD_ANA=
# MANAGER_SEED_PASSWORD_CARLOS=
# MANAGER_SEED_PASSWORD_PAULO=
# MANAGER_SEED_PASSWORD_BEATRIZ=
# SUPER_ADMIN_SEED_PASSWORD=
# PEER_PARTNER_SEED_PASSWORD_CAMILA=

# Anthropic API key, used only by scripts/model-bakeoff.ts to compare Claude
# against Groq models offline. Never needed to run the API.
# ANTHROPIC_API_KEY=

# Base URL of a running API that scripts/tone-guard-live-check.ts sends its
# scripted chat conversations to. Defaults to http://localhost:3001.
# CHAT_API_BASE_URL=http://localhost:3000

# ── CI/CD only (GitHub Actions secrets and Fly.io, never read from .env files) ─

# Turborepo remote cache. Optional: without them turbo runs with a local cache only.
# TURBO_TOKEN=
# TURBO_TEAM=

# Fly.io deploy tokens: production app and dev app, respectively.
# FLY_API_TOKEN=
# FLY_API_TOKEN_DEV=

# Connection strings of the dev database. api.yml exposes these to the CI job
# that runs `prisma migrate deploy` against dev.
# DEV_DATABASE_URL=
# DEV_DIRECT_DATABASE_URL=
