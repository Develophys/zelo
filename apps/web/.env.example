# Read by Vite at build/dev time (vite.config.ts) — every VITE_* value is baked
# into the shipped bundle, so never put a secret here.

# Base URL of the Zelo API the browser talks to. Required, and must start with
# http:// or https:// (the build fails otherwise). Point it at the deployed API
# for any non-local build.
VITE_API_BASE_URL=http://localhost:3000

# Set to "true" to build without the PWA plugin (no service worker, no manifest).
# VITE_DISABLE_PWA=false

# Opts the Capacitor Android/iOS shell into live-reload against a local Vite dev
# server instead of the bundled assets, e.g. http://10.0.2.2:5173 for the Android
# emulator (which routes that address to the host's localhost). Read by
# capacitor.config.ts. Leave unset for every real build — it must never be set
# for a release.
# CAP_DEV_SERVER_URL=
