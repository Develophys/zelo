POSTGRES_DB=zelo
POSTGRES_USER=zelo
POSTGRES_PASSWORD=devpassword
DATABASE_URL=postgresql://zelo:devpassword@postgres:5432/zelo?schema=public
DIRECT_DATABASE_URL=postgresql://zelo:devpassword@postgres:5432/zelo?schema=public
# "groq" (default) uses real Groq API calls and requires GROQ_API_KEY.
# "mock" swaps in canned AI responses for local dev/testing — no API key, no token spend.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# This stack boots with NODE_ENV=production (baked into docker/api.Dockerfile),
# so unlike apps/api/.env.example, the placeholders below are NOT accepted —
# env.validation.ts requires each HMAC key to be a real, independent 32+
# character value here. Generate one per key:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MANAGER_TOKEN_SECRET=
ADMIN_TOKEN_SECRET=
PEER_PARTNER_TOKEN_SECRET=
# "mock" (default) logs the email + set-password link to the console — but since this
# stack runs with NODE_ENV=production, EMAIL_PROVIDER must be "resend" with a real
# RESEND_API_KEY, and WEB_APP_BASE_URL must be set explicitly (see env.validation.ts).
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
WEB_APP_BASE_URL=http://localhost:8080
